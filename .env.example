# WEB — configure in Vercel (only NEXT_PUBLIC_* may enter the browser)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# CLOUDFLARE WORKER — set secrets via wrangler secret put
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
# Set only after the single approved Supabase Auth user has been created.
TRADER_USER_ID=replace-with-approved-supabase-auth-user-uuid
ENGINE_API_KEY=generate-a-strong-random-secret
ALLOWED_ORIGIN=http://localhost:3000

# FLY.IO ENGINE — configure with fly secrets set; never commit values
# OWNER_ADDRESS: your own DreamDEX Somnia Account wallet (not documented/public).
# BOT_PRIVATE_KEY: a NEW dedicated testnet bot wallet; authorize its PUBLIC address
# through DreamDEX > Link a Bot. Never use the owner's private key here.
# EXPECTED_BOT_ADDRESS: the full public address shown by DreamDEX after linking;
# live mode refuses to start unless the derived key address matches it.
THRYNT_API_URL=https://your-worker.workers.dev
THRYNT_ENGINE_API_KEY=same-random-engine-secret
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
BOT_PRIVATE_KEY=0x-your-dedicated-testnet-bot-key
EXPECTED_BOT_ADDRESS=0x0000000000000000000000000000000000000000
PORT=8080

# DREAMDEX / SOMNIA HIDEKI — public endpoints already filled from official docs.
# Source: https://app.dreamdex.io/docs/developers/perps-testnet
# Network: Somnia Hideki, chain ID 50383; gas token STT; perp margin USDso.
# SDK: @somnia-chain/markets-sdk@0.32.1 (pinned in package manifests).
SOMNIA_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
SOMNIA_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
SOMNIA_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
# Explorer: https://explorer.testnet.somnia.network/tokyo
# Official reference contracts (NOT extra env vars; SDK discovers per-market pools):
# MarginBank:                  0x478769E1177C0773c43A593DCCc4Ad15F15F1394
# Perps collateral USDso:     0xed7993A74dAe1e6656B704A424DcD8711aAf4F72
# PerpPoolFactory:             0xE631fAEE547baeE07353E290f0562ea67d856560
# LiquidationEngine:           0xA66d3C24Ad4a389d863846905D8173e1017e9F4D
# InsuranceFund:               0x50826894D47C6D4f3BeA38BFDC7Dc5c5be171b80
# VoucherDistributor:          0x2ACD9EFdA721450906bfE1bef3edE269636E42C4
# OperatorPermissionsRegistry: 0x6B2FbfeD328FF5F20C0BE7D3C3437613aFFE8D3a
# Never hardcode individual market pool addresses, min sizes or decimals: read
# them from live SDK market metadata and independently verify chain/account state.

EXECUTION_MODE=observe
# Additional two-key opt-in necessary for submitting any onchain order:
ENABLE_TESTNET_EXECUTION=false
ENGINE_INSTANCE_ID=thrynt-fly-1
