# WEB — configure in Vercel (only NEXT_PUBLIC_* may enter the browser)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# CLOUDFLARE WORKER — set secrets via wrangler secret put
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
TRADER_USER_ID=00000000-0000-0000-0000-000000000000
ENGINE_API_KEY=generate-a-strong-random-secret
ALLOWED_ORIGIN=http://localhost:3000

# FLY.IO ENGINE — configure with fly secrets set; never commit values
THRYNT_API_URL=https://your-worker.workers.dev
THRYNT_ENGINE_API_KEY=same-random-engine-secret
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
BOT_PRIVATE_KEY=0x-your-dedicated-testnet-bot-key
SOMNIA_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
SOMNIA_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
SOMNIA_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
EXECUTION_MODE=observe
# Additional two-key opt-in necessary for submitting any onchain order:
ENABLE_TESTNET_EXECUTION=false
ENGINE_INSTANCE_ID=thrynt-fly-1
